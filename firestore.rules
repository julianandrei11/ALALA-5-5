rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activePatientGrant(caregiverId, patientId) {
      let grantId = caregiverId + '__' + patientId + '__' + request.auth.uid;
      return exists(/databases/$(database)/documents/patientAccessGrants/$(grantId)) &&
        get(/databases/$(database)/documents/patientAccessGrants/$(grantId)).data.status == 'active';
    }

    function canAccessPatientData(caregiverId, patientId) {
      return signedIn() && (
        request.auth.uid == caregiverId ||
        activePatientGrant(caregiverId, patientId)
      );
    }

    match /securityCodes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /caregiver/{userId} {
      allow read: if request.auth == null;
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /caregiver/{caregiverId}/patients/{patientId} {
      allow read, write: if canAccessPatientData(caregiverId, patientId);
    }

    match /caregiver/{caregiverId}/patients/{patientId}/{document=**} {
      allow read, write: if canAccessPatientData(caregiverId, patientId);
    }

    match /trustedPatientInvites/{inviteId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.inviteeUserId
      );
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.caregiverId &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        request.auth.uid == resource.data.inviteeUserId ||
        request.auth.uid == resource.data.caregiverId
      );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.inviteeUserId
      );
    }

    /** Maps normalized join code → owning caregiver + patient (read by signed-in users to submit access requests). */
    match /patientJoinCodeLookup/{lookupKey} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.caregiverId;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.caregiverId;
    }

    /** Trusted family requests access via patient join code; caregiver approves or rejects. */
    match /patientFamilyAccessRequests/{requestId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.requesterUserId
      );
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.requesterUserId &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() &&
        request.auth.uid == resource.data.caregiverId &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'];
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.requesterUserId
      );
    }

    match /patientAccessGrants/{grantId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.familyMemberId
      );
      allow create: if signedIn() && (
        request.auth.uid == request.resource.data.caregiverId ||
        request.auth.uid == request.resource.data.familyMemberId
      );
      allow update, delete: if signedIn() && (
        request.auth.uid == resource.data.caregiverId ||
        request.auth.uid == resource.data.familyMemberId
      );
    }

    match /gameSessions/{sessionId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /userProgress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /flashcards/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
